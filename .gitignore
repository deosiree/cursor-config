# 临时文件
*.tmp
*.log

# 系统文件
.DS_Store
Thumbs.db

# 编辑器临时文件
*.swp
*.swo
*~

# 备份文件
*.bak
*.backup

# Cursor/Commit workflow 产物（不需要进入版本库）
commit-workflow-artifacts/

.obsidian/

# 环境配置（含敏感路径，不提交）
.env
.env.local
.env.*.local

# Excel 临时锁文件（打开中的 xlsx/xlsm 会产生 ~$ 前缀文件）
~$*

# Python 缓存
__pycache__/
*.pyc
