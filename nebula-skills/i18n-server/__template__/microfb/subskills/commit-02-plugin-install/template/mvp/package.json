{
  "name": "Sieyuan 云端",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 8080",
    "build": "vue-tsc -b && vite build",
    "build:dev": "vue-tsc -b && vite build --mode staging",
    "build:prod": "vue-tsc -b && vite build --mode production",
    "preview": "vite preview",
    "prepare": "husky",
    "type-check": "vue-tsc --noEmit"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{cjs,json}": [
      "prettier --write"
    ],
    "*.{vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{scss,css}": [
      "stylelint --fix --allow-empty-input",
      "prettier --write"
    ],
    "*.md": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@kjgl77/datav-vue3": "1.7.4",
    "@types/bcryptjs": "2.4.6",
    "@types/jsonwebtoken": "9.0.9",
    "@types/nprogress": "0.2.3",
    "@vueuse/core": "14.0.0",
    "axios": "1.8.4",
    "bcryptjs": "3.0.2",
    "body-parser": "1.20.3",
    "cors": "2.8.5",
    "echarts": "5.6.0",
    "echarts-gl": "2.0.9",
    "element-plus": "2.9.7",
    "express": "4.21.2",
    "jsencrypt": "3.5.4",
    "jsonwebtoken": "9.0.2",
    "mysql": "2.18.1",
    "nprogress": "0.2.0",
    "path-browserify": "^1.0.1",
    "path-to-regexp": "8.3.0",
    "pinia": "2.3.1",
    "pinia-plugin-persistedstate": "3.2.3",
    "qiankun": "2.10.16",
    "qs": "6.14.0",
    "vite-plugin-qiankun": "1.0.15",
    "vitest": "^4.1.4",
    "vue": "3.5.14",
    "vue-i18n": "11.3.2",
    "vue-i18n-kit-sy": "^1.0.3",
    "vue-router": "4.5.0"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/echarts": "4.9.22",
    "@types/express": "5.0.1",
    "@types/lodash": "^4.17.20",
    "@types/node": "22.14.1",
    "@types/path-browserify": "^1.0.3",
    "@types/qs": "^6.14.0",
    "@typescript-eslint/eslint-plugin": "8.28.0",
    "@typescript-eslint/parser": "8.28.0",
    "@vitejs/plugin-vue": "5.2.3",
    "@vue/compiler-sfc": "3.5.13",
    "@vue/runtime-dom": "3.5.13",
    "@vue/tsconfig": "0.7.0",
    "eslint": "9.23.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "lodash": "4.17.21",
    "postcss": "8.5.3",
    "prettier": "3.6.2",
    "sass": "1.86.0",
    "sass-loader": "16.0.5",
    "stylelint": "^16.17.0",
    "stylelint-config-standard-scss": "14.0.0",
    "stylelint-scss": "6.11.1",
    "terser": "^5.44.1",
    "typescript": "~5.7.2",
    "unocss": "66.5.5",
    "unplugin-auto-import": "20.2.0",
    "unplugin-element-plus": "0.9.1",
    "unplugin-vue-components": "28.5.0",
    "vite": "6.2.0",
    "vite-plugin-svg-icons": "2.0.1",
    "vue-tsc": "2.2.4"
  }
}
