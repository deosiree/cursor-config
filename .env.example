# ===== 模型配置说明 =====
# 模型清单、路数、批大小、定价、供应商信息：agent-skills/多模型并发调度/lib/models.config.json
# 本文件只存 API Key；模型增删/换模/调路数在 models.config.json 中操作。
# 两个文件配合使用：models.config.json 声明模型 → .env 提供对应 Key。
# ========================

# ===== API keys =====
# 复制本文件为 .env 后填入真实值；.env 已在 .gitignore，勿提交。
# 探测全部模型：cd agent-skills/多模型并发调度 && node scripts/probe-models.js

# 讯飞星辰（OpenAI 兼容，翻译服务）
# 注意：model 字段用控制台 modelId（xophunyuan7bmt=Hy-MT2-7B），非展示名
XFYUN_API_KEY=
XFYUN_BASE_URL=https://maas-api.cn-huabei-1.xf-yun.com/v2
XFYUN_MODEL=xophunyuan7bmt
XFYUN_SERVICE=translation
# ↑ XFYUN_MODEL @legacy：translateCsv.js 内部 fallback，模型选定以 models.config.json 为准

# 智谱（免费模型 / fallback）
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
ZHIPU_MODEL=glm-4-flash
# ↑ ZHIPU_MODEL @legacy

# 硅基流动（OpenAI 兼容）
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=tencent/Hunyuan-MT-7B
# ↑ SILICONFLOW_MODEL @legacy

# DeepSeek（主力模型，付费；翻译等批量任务默认不走此池）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
