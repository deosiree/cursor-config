{
  "skill": "组件-操作列折叠",
  "version": "1.3.0",
  "truthCommit": "5cc2e14311c9a503ee22540459c70ccb49d0b2ef",
  "cases": [
    {
      "id": "trigger-overflow-more",
      "type": "should-trigger",
      "prompt": "列表操作列按钮太多，想行内只显示1个，其余放到更多菜单",
      "expectedArtifacts": [
        "OperationColumn",
        "OpItem",
        "inline-visible-count=2",
        "slot-semantics",
        "更多"
      ]
    },
    {
      "id": "trigger-replace-el-button",
      "type": "should-trigger",
      "prompt": "把表格操作列的 el-button 换成全局 OperationColumn 组件",
      "expectedArtifacts": [
        "OpItem",
        "perm=",
        "list-data-length"
      ]
    },
    {
      "id": "trigger-new-component",
      "type": "should-trigger",
      "prompt": "仓库还没有 OpItem，需要新建 OperationColumn 溢出套件",
      "expectedRoute": "新增-OperationColumn溢出套件",
      "expectedArtifacts": [
        "calcOpStrip",
        "mkWidthCoord",
        "OperationCellOverflow",
        "operationWidth",
        "__tests__"
      ]
    },
    {
      "id": "trigger-tenant-table",
      "type": "should-trigger",
      "prompt": "租户 TenantTable 6 个操作要全行内，组件已有",
      "expectedRoute": "更新-页面接入OperationColumn",
      "expectedArtifacts": [
        "TenantTable",
        "inline-visible-count=6",
        "去掉 width"
      ]
    },
    {
      "id": "not-trigger-layout-height",
      "type": "should-not-trigger",
      "prompt": "列表页放大后分页被挡住，表格要内部滚动",
      "expectedRoute": "layout-fixedHeadTail-adaptiveMiddle"
    },
    {
      "id": "not-trigger-i18n-migration",
      "type": "should-not-trigger",
      "prompt": "把整个项目的 i18n 迁到新插件",
      "expectedRoute": "i18n-server"
    },
    {
      "id": "trigger-user-table-cross",
      "type": "should-trigger",
      "prompt": "用户 UserTable 多 v-if，编辑+更多，启用后操作列要刷新",
      "expectedRoute": "更新-页面接入OperationColumn",
      "expectedArtifacts": [
        "UserTable",
        "inline-visible-count=2",
        "tblProbeFp",
        "v-if on OpItem"
      ]
    },
    {
      "id": "trigger-menu-tree-table",
      "type": "should-trigger",
      "prompt": "菜单树表 row.type 不同，权限弹窗3槽 API4槽，不要手写探针表",
      "expectedRoute": "更新-页面接入OperationColumn",
      "expectedArtifacts": [
        "menu-table-replace",
        "inline-visible-count=3",
        "inline-visible-count=4",
        "禁止 probe-data-rows"
      ]
    }
  ]
}
